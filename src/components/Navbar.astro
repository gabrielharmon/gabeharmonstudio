---
// src/components/Navbar.astro
---

<nav class="navbar">
    <img class="logo" src="public\block-logo-white.svg" alt="Navigation Bar Logo" />

    <ul class="nav-links">
        <li><a href="/prismatica">Prismatica</a></li>
        <li><a href="/art">Art</a></li>
        <li><a href="/games">Games</a></li>
        <li><a href="/blog"></a></li>
        <li><a href="/blog">Updates</a></li>
        <li><a href="/projects">Info</a></li>
    </ul>
</nav>

<style>
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .5rem 1rem;
        background-color: black;
        color: #fff;
        font-family: "Francois One", system-ui, sans-serif;
        text-transform: lowercase;
        font-size: 0.8rem;
    }

    .logo {
        width: 45px;
    }

    .nav-links,
    .social-links {
        display: flex;
        list-style: none;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
    }

    a {
        color: white;
        text-decoration: none;
    }

    a:hover {
        color: #c5c5c5;
    }

    /* For mobile device responsiveness */
    @media (max-width: 768px) {
        .navbar {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>
